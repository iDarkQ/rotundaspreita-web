{
  "name": "rotundaspreita",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev --port 3000",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:server": "tsx tests/e2e/setup.ts && next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "preview": "next start --port 3002",
    "lint": "eslint",
    "lint-check": "eslint-config-prettier app/page.tsx",
    "prettier": "prettier --write app/",
    "docker:build": "docker build --no-cache -t iDarkQ/rotundaspreita-web:latest .",
    "docker:compose": "docker compose up -d --build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@next/third-parties": "^16.0.10",
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/adapter-pg": "^7.0.1",
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "jsonwebtoken": "^9.0.2",
    "next": "16.0.10",
    "pg": "8.16.3",
    "posthog-js": "^1.302.0",
    "rate-limiter-flexible": "^11.2.1",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "stripe": "^20.0.0",
    "vanilla-tilt": "^1.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/client": "^7.0.0",
    "@prisma/extension-accelerate": "^3.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
