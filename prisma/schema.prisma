generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OptionLetter {
  A
  B
  C
  D
  E
}

enum ReminderDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model User {
  id           String  @id @default(cuid())
  googleId     String? @unique
  email        String  @unique
  name         String
  passwordHash String?

  admin Boolean @default(false)

  usedFreeTest Boolean @default(false)

  banned    Boolean  @default(false)
  createdAt DateTime @default(now())

  onboardingCompleted      Boolean   @default(false)
  onboardingDeferredAt     DateTime?
  examDate                 DateTime?
  weeklyTestGoal           Int?
  reminderWeekdays         Int[]     @default([])
  reminderTime             String?
  reminderTimezone         String?
  pushNotificationsEnabled Boolean   @default(false)

  deviceSessions     DeviceSession[]
  testResults        TestResult[]
  pushSubscriptions  PushSubscription[]
  reminderDeliveries ReminderDelivery[]

  subscription Subscription?

  testimonial Testimonial?
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReminderDelivery {
  id            String                 @id @default(cuid())
  localDate     String
  status        ReminderDeliveryStatus @default(PENDING)
  attempts      Int                    @default(0)
  nextAttemptAt DateTime               @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime               @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([status, nextAttemptAt])
}

model Testimonial {
  id String @id @default(cuid())

  anonymous Boolean @default(false)

  message String

  users  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

model Subscription {
  id String @id @default(cuid())

  stripeSubId String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime @default(dbgenerated("now() + interval '30 days'"))

  cancelled Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model DeviceSession {
  id        String @id @default(cuid())
  ipAddress String
  userAgent String
  jwtToken  String

  lastActive DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TestResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  markAsNew Boolean @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionId String?
  option   Option? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studyId   String
  study     Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)
  testRunId String
}

model Study {
  id          String       @id @default(cuid())
  title       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   Question[]
  testResults TestResult[]
}

model Question {
  id        String   @id @default(cuid())
  content   String
  category  String?
  studyId   String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  study    Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  options Option[] @relation("QuestionOptions")

  testResults TestResult[]
}

model Option {
  id         String       @id @default(cuid())
  content    String
  letter     OptionLetter
  answer     Boolean
  questionId String
  deleted    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  question Question @relation("QuestionOptions", fields: [questionId], references: [id], onDelete: Cascade)

  testResults TestResult[]
}
